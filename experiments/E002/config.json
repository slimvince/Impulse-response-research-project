  "tool": "Spotify Basic Pitch",
  "tool_version": "0.4.0",
  "python_version": "3.11.9",
  "os": "Windows 11",
  "tensorflow_version": "2.15.0",
  "framework": "tensorflow-cpu",
  "parameters": [
    {
      "id": "default",
      "onset_threshold": 0.5,
      "frame_threshold": 0.3,
      "minimum_note_length": 127.7,
      "minimum_frequency": 40.0,
      "maximum_frequency": 400.0,
      "multiple_pitch_bends": false,
      "melodia_trick": true,
      "notes": "Basic Pitch defaults for the first pilot run."
    },
    {
      "id": "stricter",
      "onset_threshold": 0.7,
      "frame_threshold": 0.5,
      "minimum_note_length": 200.0,
      "minimum_frequency": 40.0,
      "maximum_frequency": 400.0,
      "multiple_pitch_bends": false,
      "melodia_trick": true,
      "notes": "Stricter filtering to test whether conservative event filtering yields a more usable subset."
    },
    {
      "id": "low-register",
      "onset_threshold": 0.7,
      "frame_threshold": 0.5,
      "minimum_note_length": 200.0,
      "minimum_frequency": 40.0,
      "maximum_frequency": 250.0,
      "multiple_pitch_bends": false,
      "melodia_trick": true,
      "notes": "Low-register gate designed to suppress spurious upper-register detections."
    },
    {
      "id": "bass-friendly",
      "onset_threshold": 0.65,
      "frame_threshold": 0.45,
      "minimum_note_length": 150.0,
      "minimum_frequency": 40.0,
      "maximum_frequency": 600.0,
      "multiple_pitch_bends": false,
      "melodia_trick": true,
      "notes": "Broader bass range intended to include upper-register fundamentals without becoming too loose."
    },
    {
      "id": "broad-bass",
      "onset_threshold": 0.55,
      "frame_threshold": 0.35,
      "minimum_note_length": 120.0,
      "minimum_frequency": 35.0,
      "maximum_frequency": 700.0,
      "multiple_pitch_bends": false,
      "melodia_trick": true,
      "notes": "More permissive sweep to test whether additional high-register detections are valid or noisy."
    }
  ],
  "notes": "This experiment tests whether range-specific parameter sweeps improve event validity. The broader range pass was not yet treated as adequate without a listener review."
}
